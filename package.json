    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "loginlink": "tsx scripts/loginlink.ts",
    "setpassword": "tsx scripts/setpassword.ts",
    "backup": "tsx scripts/backup.ts",
    "upload-obsidian": "tsx scripts/upload-obsidian-note.ts",
    "docbased": "tsx scripts/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "^0.10.3",
