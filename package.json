{
  "name": "docbased",
  "version": "0.1.0",
  "description": "Self-hosted documentation search and RAG chat over multiple knowledge spaces, with per-user access control.",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "docbased": "./scripts/docbased-bin.mjs"
  },
