# Copy to .env.local and fill in. Never commit .env.local — it is gitignored.

# --- Supabase -----------------------------------------------------------------
# Project Settings → Data API. Both the URL and the publishable key are safe to
# expose in the browser bundle; the secret key is not.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Bypasses Row Level Security — never expose to the client.
# Legacy projects can use SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=sb_secret_...

# Project Settings → Database → Connection string (Transaction-mode pooler).
# Used by the migration runner, drizzle-kit studio, and pg_dump backups.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:6543/postgres

# --- OpenRouter ---------------------------------------------------------------
# One key covers embeddings, chat completions, and reranking.
OPENROUTER_API_KEY=sk-or-v1-...

# Must produce 1536-dim vectors, or migrate the chunks.embedding column first.
EMBEDDING_MODEL=openai/text-embedding-3-small
DEFAULT_CHAT_MODEL=anthropic/claude-sonnet-4.5
RERANKER_MODEL=cohere/rerank-3.5
# Reranking is best-effort; set false to fall back to Reciprocal Rank Fusion order.
RERANKER_ENABLED=true

# --- Operational --------------------------------------------------------------
# Informational only — set the real ceiling in the OpenRouter dashboard too.
MONTHLY_SPEND_CEILING=50
# Per-user daily chat-message cap.
CHAT_DAILY_LIMIT=50
# Used to build magic-link redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. If set, page requests to the apex host 308-redirect here so the site
# has one canonical origin. /mcp and /api are never redirected — a cross-origin
# hop strips the Authorization header. Leave unset to disable canonicalization.
# NEXT_PUBLIC_CANONICAL_HOST=www.example.com

# Optional. The weekly Vercel cron at /api/cron/backup POSTs here so an external
# runner that has pg_dump can take the snapshot. Leave unset to disable.
# CRON_BACKUP_WEBHOOK=https://...

# --- CLI (scripts/cli.ts) -----------------------------------------------------
# Service mode reuses SUPABASE_* + OPENROUTER_API_KEY above. Set these two to
# run the CLI scoped to a real user instead of the first admin.
# DOCBASED_EMAIL=you@example.com
# DOCBASED_PASSWORD=
